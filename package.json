{
  "name": "reputacion-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "superadmin:create": "tsx --conditions=react-server --env-file-if-exists=.env scripts/create-superadmin.ts",
    "demo:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed-demo.ts",
    "retention:run": "tsx --conditions=react-server --env-file-if-exists=.env scripts/run-retention.ts",
    "test:web:rules": "firebase emulators:exec --only firestore --project demo-reputacion \"vitest run -c vitest.web.config.ts\"",
    "web:build": "node web/build.mjs",
    "web:serve": "node web/build.mjs && node web/serve.mjs",
    "test:web": "node web/build.mjs && OUT_DIR=web/dist-emu WEB_CONFIG=tests/web-e2e/emulator-config.js node web/build.mjs && firebase emulators:exec --only firestore,auth --project demo-reputacion \"vitest run -c vitest.web.config.ts && playwright test -c playwright.web.config.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "embedded-postgres": "^16.13.0-beta.17",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.27.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.29",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
