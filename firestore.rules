rules_version = '2';

// ReseñaQR — reglas de seguridad de Firestore.
//
// Modelo:
//   admins/{uid}                      superadministradores (se crean con tools/crear-negocio.mjs --superadmin)
//   access/{slug}                     { ownerUids: [], ownerEmails: [] }  quién administra cada negocio
//   businesses/{slug}                 perfil público (nombre, logo, rubro, dirección, enlace de Google)
//   businesses/{slug}/feedback/{id}   opiniones (las crea el público; las lee y gestiona solo el negocio)
//   throttle/{uid}                    último envío de cada visitante (límite contra envíos abusivos)
//
// Los negocios los crea, suspende o elimina el superadministrador desde #/admin
// (o con tools/crear-negocio.mjs). Los dueños solo gestionan su propio negocio.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function accessPath(slug) { return /databases/$(database)/documents/access/$(slug); }
    function bizPath(slug) { return /databases/$(database)/documents/businesses/$(slug); }
    function feedbackPath(slug, id) { return /databases/$(database)/documents/businesses/$(slug)/feedback/$(id); }
    function throttlePath(uid) { return /databases/$(database)/documents/throttle/$(uid); }
    function isOwner(slug) {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(accessPath(slug))
        && request.auth.uid in get(accessPath(slug)).data.ownerUids;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function canManage(slug) { return isOwner(slug) || isAdmin(); }
    function businessActive(slug) {
      return exists(bizPath(slug)) && get(bizPath(slug)).data.active == true;
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // Segundos mínimos entre dos opiniones del mismo visitante.
    function minGap() { return duration.value(30, 's'); }

    // ── Quién administra cada negocio ──────────────────────────────────
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false; // solo con la herramienta o la consola de Firebase
    }

    match /access/{slug} {
      allow get: if canManage(slug);
      // Para que un dueño encuentre "sus" negocios (consulta array-contains).
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.ownerUids);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['ownerUids', 'ownerEmails'])
        && request.resource.data.ownerUids is list && request.resource.data.ownerUids.size() <= 10
        && request.resource.data.get('ownerEmails', []) is list;
      allow delete: if isAdmin();
    }

    // ── Perfil público del negocio ─────────────────────────────────────
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'industry', 'address', 'logo', 'googleReviewUrl', 'active', 'createdAt', 'updatedAt'])
        && str(d.name, 80) && d.name.size() >= 2
        && str(d.industry, 60)
        && str(d.address, 160)
        && (d.logo == null || (str(d.logo, 200000) && d.logo.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')))
        && (d.googleReviewUrl == null || (str(d.googleReviewUrl, 500) && d.googleReviewUrl.matches('^https://[^/@]+/.*')))
        && d.active is bool;
    }

    match /businesses/{slug} {
      // Público: la pantalla del QR necesita nombre, logo, rubro, dirección y enlace.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && slug.matches('^[a-z0-9](?:[a-z0-9-]{0,48}[a-z0-9])?$')
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
      // El dueño edita sus datos, pero no puede activarse/suspenderse; el superadministrador sí.
      allow update: if canManage(slug)
        && validProfile(request.resource.data)
        && (isAdmin() || request.resource.data.active == resource.data.active)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.updatedAt == request.time;

      // ── Opiniones ─────────────────────────────────────────────────
      match /feedback/{id} {
        function validNew(d) {
          return d.keys().hasOnly(['rating', 'comment', 'uid', 'status', 'createdAt'])
            && d.rating is int && d.rating >= 1 && d.rating <= 5
            && str(d.comment, 1000)
            && (d.rating < 5 || d.comment == '')
            && d.uid == request.auth.uid
            && d.status == 'pending'
            && d.createdAt == request.time;
        }
        // Cualquier visitante (sesión anónima, sin cuenta) puede dejar UNA opinión
        // cada 30 s, y solo junto con su registro de límite (escritura en lote).
        allow create: if signedIn()
          && businessActive(slug)
          && id.matches('^[a-f0-9]{24}$')
          && validNew(request.resource.data)
          && getAfter(throttlePath(request.auth.uid)).data.at == request.time
          && getAfter(throttlePath(request.auth.uid)).data.slug == slug
          && getAfter(throttlePath(request.auth.uid)).data.fid == id;

        // El negocio la lee; el visitante solo puede comprobar si SU envío llegó
        // (para reintentar sin duplicar).
        allow get: if canManage(slug) || (signedIn() && resource.data.uid == request.auth.uid);
        allow list: if canManage(slug);

        // El negocio solo cambia el seguimiento y su nota interna; nunca la puntuación ni el comentario.
        allow update: if canManage(slug)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'resolvedAt', 'noteUpdatedAt'])
          && request.resource.data.status in ['pending', 'resolved']
          && (!('note' in request.resource.data) || str(request.resource.data.note, 2000));
        // Solo el superadministrador borra (por ejemplo, las opiniones de prueba).
        allow delete: if isAdmin();
      }
    }

    // ── Límite de envíos por visitante ─────────────────────────────────
    match /throttle/{uid} {
      function validThrottle() {
        let d = request.resource.data;
        return signedIn() && request.auth.uid == uid
          && d.keys().hasOnly(['at', 'slug', 'fid'])
          && d.at == request.time
          && d.slug is string && d.fid is string
          && existsAfter(feedbackPath(d.slug, d.fid))
          && !exists(feedbackPath(d.slug, d.fid));
      }
      allow create: if validThrottle();
      allow update: if validThrottle() && request.time > resource.data.at + minGap();
      allow read, delete: if false;
    }
  }
}
