// Reputación OS — modelo de datos
//
// Principios:
// - Cada negocio es un "tenant". Las tablas con datos privados de un negocio
//   (opiniones, notas, categorías y selecciones) llevan businessId y además
//   están protegidas con Row Level Security en PostgreSQL (ver migración rls).
// - No se guardan datos personales de los clientes finales: la opinión pública
//   es anónima (puntuación, comentario y categorías).
// - Las claves foráneas compuestas (id, businessId) garantizan en la base de datos
//   que una nota o una categoría nunca pueda apuntar a otro negocio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  USER
}

enum MemberRole {
  OWNER
  MEMBER
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

enum PlanTier {
  BASICO
  PROFESIONAL
  PREMIUM
}

enum PlanStatus {
  ACTIVE
  ENDED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum FeedbackStatus {
  NEW
  REVIEWED
}

model User {
  id           String    @id @default(cuid())
  /// Siempre en minúsculas.
  email        String    @unique
  name         String?
  /// Hash bcrypt. Nunca se guarda la contraseña en texto plano.
  passwordHash String
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships        BusinessMember[]
  sessions           Session[]
  notes              FeedbackNote[]
  reviewedFeedback   Feedback[]       @relation("FeedbackReviewer")
  auditLogs          AuditLog[]
  invitationsCreated Invitation[]
  passwordResets     PasswordReset[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 del token de sesión. El token real solo vive en la cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Enlace de un solo uso para elegir una contraseña nueva (lo genera el superadministrador).
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 del token; el enlace se muestra una sola vez.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model Business {
  id              String         @id @default(cuid())
  name            String
  /// Identificador estable usado en la URL pública /r/{slug} y en el QR.
  slug            String         @unique
  industry        String         @default("comercio")
  logoData        Bytes?
  logoMimeType    String?
  logoUpdatedAt   DateTime?
  brandColor      String         @default("#0f766e")
  googleReviewUrl String?
  welcomeMessage  String         @default("¿Cómo fue tu experiencia?")
  thankYouMessage String         @default("¡Gracias por tomarte un momento para contarnos!")
  timezone        String         @default("America/Argentina/Buenos_Aires")
  status          BusinessStatus @default(ACTIVE)
  plan            PlanTier       @default(BASICO)
  /// Negocio de demostración: sus opiniones son ficticias y se marcan como DEMO.
  isDemo          Boolean        @default(false)
  /// Puntuación mínima considerada positiva (por defecto 4 y 5).
  positiveMin     Int            @default(4)
  /// Puntuación máxima considerada negativa (por defecto 1 y 2).
  negativeMax     Int            @default(2)
  /// Meses que se conservan las opiniones antes de eliminarse.
  retentionMonths Int            @default(24)
  contactEmail    String?
  /// Notas internas del proveedor del servicio (solo superadministrador).
  internalNotes   String?
  suspendedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  members     BusinessMember[]
  invitations Invitation[]
  plans       BusinessPlan[]
  categories  FeedbackCategory[]
  feedback    Feedback[]
  notes       FeedbackNote[]
  selections  FeedbackCategorySelection[]
  slugHistory BusinessSlugHistory[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([plan])
  @@index([name])
  @@map("businesses")
}

/// Slugs anteriores: permiten que los QR ya impresos sigan funcionando
/// aunque se cambie el slug del negocio.
model BusinessSlugHistory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug       String   @unique
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@map("business_slug_history")
}

model BusinessMember {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       MemberRole @default(MEMBER)
  createdAt  DateTime   @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_members")
}

model Invitation {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(OWNER)
  /// SHA-256 del token. El enlace con el token se muestra una sola vez.
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([businessId])
  @@map("invitations")
}

model BusinessPlan {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan       PlanTier
  status     PlanStatus @default(ACTIVE)
  startsAt   DateTime   @default(now())
  endsAt     DateTime?
  createdAt  DateTime   @default(now())

  @@index([businessId, status])
  @@map("business_plans")
}

model FeedbackCategory {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  status     CategoryStatus @default(ACTIVE)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  selections FeedbackCategorySelection[]

  @@unique([id, businessId])
  @@unique([businessId, name])
  @@index([businessId, status])
  @@map("feedback_categories")
}

model Feedback {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// 1 a 5. Restringido también con CHECK en la base de datos. No editable.
  rating        Int
  comment       String?
  status        FeedbackStatus @default(NEW)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?          @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Clave generada por el navegador para evitar duplicados por doble envío.
  submissionKey String
  createdAt     DateTime       @default(now())

  selections FeedbackCategorySelection[]
  notes      FeedbackNote[]

  @@unique([id, businessId])
  @@unique([businessId, submissionKey])
  @@index([businessId, createdAt])
  @@index([businessId, rating])
  @@index([businessId, status])
  @@map("feedback")
}

model FeedbackCategorySelection {
  feedbackId String
  categoryId String
  businessId String
  feedback   Feedback         @relation(fields: [feedbackId, businessId], references: [id, businessId], onDelete: Cascade)
  category   FeedbackCategory @relation(fields: [categoryId, businessId], references: [id, businessId], onDelete: Cascade)
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([feedbackId, categoryId])
  @@index([businessId, categoryId])
  @@map("feedback_category_selections")
}

model FeedbackNote {
  id         String   @id @default(cuid())
  feedbackId String
  businessId String
  feedback   Feedback @relation(fields: [feedbackId, businessId], references: [id, businessId], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
  @@index([businessId])
  @@map("feedback_notes")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  action     String
  /// Metadatos mínimos. Nunca incluir comentarios de clientes ni contraseñas.
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Contadores de limitación de frecuencia. La clave es un hash (nunca la IP en claro).
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}
