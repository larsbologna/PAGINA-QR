# ─────────────────────────────────────────────────────────────
# Reputación OS — variables de entorno (copiá este archivo a .env)
# NUNCA subas el archivo .env con credenciales reales al repositorio.
# ─────────────────────────────────────────────────────────────

# Conexión a PostgreSQL. Usá un rol SIN privilegios de superusuario ni BYPASSRLS,
# para que las políticas de aislamiento por negocio (RLS) se apliquen.
DATABASE_URL="postgresql://reputacion:CAMBIAR_PASSWORD@localhost:5432/reputacion?schema=public"

# URL pública de la aplicación (sin barra final). Se usa para los enlaces y QR.
# En producción debe ser https://tu-dominio.com
APP_URL="http://localhost:3000"

# Nombre comercial del producto (se puede cambiar sin tocar código).
PRODUCT_NAME="Reputación OS"
# Datos del proveedor del servicio, usados en Privacidad y Términos.
PROVIDER_NAME="Tu nombre o empresa"
PROVIDER_CONTACT_EMAIL="contacto@tu-dominio.com"

# Secreto para derivar hashes de IP en la limitación de frecuencia.
# Generalo con: openssl rand -base64 32
APP_SECRET="CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO"

# true si la app corre detrás de un proxy confiable (Vercel, Render, Nginx)
# que completa X-Forwarded-For.
TRUST_PROXY="true"

# Límites de envío de opiniones públicas por IP (ventana de 1 hora).
RATE_LIMIT_FEEDBACK_PER_HOUR="10"
# Intentos de inicio de sesión por IP+email (ventana de 15 minutos).
RATE_LIMIT_LOGIN_PER_15MIN="10"

# Duración de la sesión de administración en días.
SESSION_DAYS="14"
